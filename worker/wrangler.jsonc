{
  "name": "bjj-connections",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": { "CHAT_ENABLED": "true" },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "63001", "simple": { "limit": 5, "period": 60 } },
    { "name": "SERVICE_RATE_LIMITER", "namespace_id": "63002", "simple": { "limit": 30, "period": 60 } }
  ]
}
